{
  "name": "klever-connect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unified JavaScript SDK for interacting with Klever blockchain",
  "repository": {
    "type": "git",
    "url": "https://github.com/klever-io/klever-connect.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:integration": "pnpm --filter '@klever/connect-provider' --filter '@klever/connect-transactions' run test:integration",
    "benchmark": "turbo run benchmark",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --check"
    ],
    "*.{ts,tsx}": [
      "eslint"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.10",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@typhonjs-typedoc/typedoc-theme-dmt": "^0.4.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "protobufjs": "^7.6.5",
    "protobufjs-cli": "^1.3.3",
    "tsup": "^8.5.1",
    "turbo": "^2.9.14",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.6",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1",
      "glob": "13.0.1",
      "@isaacs/brace-expansion": "5.0.1",
      "brace-expansion": "^5.0.7",
      "rollup": "4.59.0",
      "glob>minimatch": "10.2.3",
      "markdown-it": "^14.2.0",
      "underscore": "1.13.8",
      "flatted": "3.4.2",
      "undici": "^7.29.0",
      "postcss": "^8.5.18",
      "qs": "^6.15.2",
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "form-data": "^4.0.6",
      "vitest": "^3.2.6",
      "@vitest/coverage-v8": "^3.2.6",
      "@vitest/ui": "^3.2.6",
      "vite": "^7.3.5",
      "ws": "^8.21.0",
      "tmp": "^0.2.7",
      "js-yaml": "^4.3.1",
      "protobufjs": "^7.6.5",
      "protobufjs-cli": "^1.3.3",
      "read-yaml-file>js-yaml": "^3.15.1",
      "@changesets/parse>js-yaml": "^4.3.1"
    }
  }
}
