    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@klever/connect": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
