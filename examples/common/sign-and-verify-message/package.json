{
  "name": "@klever-examples/common-sign-and-verify-message",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sign arbitrary text/bytes with a private key, verify the signature, demonstrate tamper detection.",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run --exclude \"**/*.testnet.*\"",
    "test:testnet": "vitest run src/sign-and-verify-message.testnet.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@klever/connect": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
