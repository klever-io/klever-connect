# Hex Ed25519 private key of the buyer. REQUIRED.
PRIVATE_KEY=

# KDA asset id of the ITO you are buying from. REQUIRED.
KDA_ID=

# Currency the buyer pays in (must match a currency configured in the ITO's packInfo). Default KLV.
CURRENCY_ID=KLV

# Quantity of tokens to buy in raw smallest units. Required.
AMOUNT=1

# Total currency the buyer commits in raw smallest units. Required and should equal pack price × amount.
CURRENCY_AMOUNT=1000000

KLV_NETWORK=testnet
DRY_RUN=true
