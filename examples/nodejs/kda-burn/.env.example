# Hex Ed25519 key. Wallet must hold the burn-eligible balance and (typically) be
# the owner or hold the burn role.
KLV_PRIVATE_KEY=

# Asset id to burn. For NFTs, supply the FULL nft id (TICKER-XXXX/<nonce>).
KLV_KDA_ID=

# Amount to burn in smallest units. For NFTs, must be 1.
KLV_BURN_AMOUNT=1000

# Network. Default testnet.
KLV_NETWORK=testnet
