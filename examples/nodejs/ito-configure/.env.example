# Hex Ed25519 private key of the ITO owner (the KDA admin/owner). REQUIRED.
PRIVATE_KEY=

# KDA asset id whose ITO is being configured (e.g. "MYTKN-AB12"). REQUIRED.
KDA_ID=

# Address that receives ITO sale proceeds. Optional — defaults to the signer.
RECEIVER_ADDRESS=

# Status: 0=Inactive, 1=Active, 2=Paused. Optional.
STATUS=1

# Maximum total amount that can be sold across the ITO, in raw smallest units.
# Optional. Leave blank for "no cap".
MAX_AMOUNT=

# Per-buyer default purchase limit in raw smallest units. Optional.
DEFAULT_LIMIT_PER_ADDRESS=

# Whitelist status: 0=Disabled, 1=Active. Optional.
WHITELIST_STATUS=0

# ITO open/close timestamps in seconds since epoch. Optional.
START_TIME=
END_TIME=
WHITELIST_START_TIME=
WHITELIST_END_TIME=

# JSON map of currencyId -> PackInfo. Optional. Example:
# PACK_INFO_JSON='{"KLV":{"packs":[{"amount":"1","price":"1000000"}]}}'
PACK_INFO_JSON=

KLV_NETWORK=testnet
DRY_RUN=true
