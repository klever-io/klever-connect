# Sender's hex Ed25519 key. The wallet that owns the bucket.
KLV_PRIVATE_KEY=

# REQUIRED: Bucket id from a previous freeze tx. Find it on the Klever explorer
# under your freeze tx's receipt. Looks like a hex string.
KLV_BUCKET_ID=

# Asset frozen in that bucket. Default: KLV.
KLV_KDA=KLV

# Network. Default testnet.
KLV_NETWORK=testnet
