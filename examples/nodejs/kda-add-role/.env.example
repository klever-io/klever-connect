# Asset OWNER's hex Ed25519 key. Roles can only be granted by the owner; the
# canAddRoles flag must be true on the asset.
KLV_PRIVATE_KEY=

# Asset id (e.g. MTT-ABCD).
KLV_KDA_ID=

# Address that will receive the role(s).
KLV_ROLE_ADDRESS=

# Role flags. Set to "1" or "0". Defaults all-false except mint=true.
KLV_ROLE_MINT=1
KLV_ROLE_SET_ITO_PRICES=0

# Network. Default testnet.
KLV_NETWORK=testnet
