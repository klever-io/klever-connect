# Hex-encoded 32-byte Ed25519 private key controlling the SENDING wallet.
# Required. Must hold at least 1 KLV plus enough for the network fee.
KLV_PRIVATE_KEY=

# Bech32 address that will receive the transfer.
# If unset, falls back to the sender's own address (self-send).
KLV_RECIPIENT=

# Network to broadcast on. One of: mainnet | testnet | devnet
# Default is testnet so an accidental run on production is impossible.
KLV_NETWORK=testnet

# Amount to send in human-readable KLV. Default is "1".
KLV_AMOUNT=1
