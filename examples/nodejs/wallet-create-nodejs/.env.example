# Hex-encoded 32-byte Ed25519 private key (no 0x prefix).
# Used to demonstrate path #1 (env-supplied key). If unset, that path is skipped
# and only paths #2 (generate) and #3 (factory.createRandom) run.
KLV_PRIVATE_KEY=

# Network to bind the provider to. One of: mainnet | testnet | devnet
KLV_NETWORK=testnet
