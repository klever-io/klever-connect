# Hex Ed25519 private key of the buyer. REQUIRED.
PRIVATE_KEY=

# Buy type:
#   0 = MARKET — buy / bid on a marketplace listing (use ORDER_ID).
#   1 = ITO    — buy from an ITO (use ITO_KDA_ID; flow 45 covers this dedicated path).
BUY_TYPE=0

# Order id from flow 40 (marketplace-list-asset). REQUIRED when BUY_TYPE=0.
ORDER_ID=

# Optional currency id (the chain has a default per marketplace; set explicitly to override).
CURRENCY_ID=KLV

# Quantity to buy in raw smallest units. Required for fungible/auction bids.
AMOUNT=

# Total currency amount the buyer is willing to spend in raw smallest units.
# Required for BuyItNow (= price) and for auction bids (= bid amount).
CURRENCY_AMOUNT=1000000

KLV_NETWORK=testnet
DRY_RUN=true
