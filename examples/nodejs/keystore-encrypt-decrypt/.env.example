# Path on disk where the encrypted keystore JSON will be written and read back.
# Defaults to ./wallet.keystore.json relative to the example folder.
KEYSTORE_PATH=./wallet.keystore.json

# Password used to encrypt/decrypt the keystore.
# REQUIRED. There is no recovery path if you lose the password.
# Use a strong, unique passphrase. Never commit it to version control.
KEYSTORE_PASSWORD=replace-with-a-strong-passphrase

# Network to bind the wallet's provider to. The keystore itself is network-agnostic
# (it only stores the encrypted private key), but a connected wallet needs a provider.
# One of: mainnet | testnet | devnet
KLV_NETWORK=testnet
