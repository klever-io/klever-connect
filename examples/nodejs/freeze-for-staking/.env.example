# Sender's hex Ed25519 key. Wallet must hold AMOUNT plus enough KLV for the fee.
KLV_PRIVATE_KEY=

# Network. Default testnet.
KLV_NETWORK=testnet

# Amount to freeze, in human-readable KLV. Default: 100.
KLV_FREEZE_AMOUNT=100

# Optional KDA id to freeze instead of KLV. Frozen KDA does NOT create a bucket
# (KDA freeze is for asset-specific staking pools, not consensus delegation).
# Leave blank to freeze native KLV.
KLV_FREEZE_KDA=
