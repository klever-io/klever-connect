# Hex-encoded sender private key. Wallet must hold a balance of KLV_KDA_ID and a
# small amount of KLV for the network fee.
KLV_PRIVATE_KEY=

# Recipient bech32 address. Defaults to the sender's own address (self-send).
KLV_RECIPIENT=

# Asset id to transfer, e.g. "MTT-ABCD" for a fungible token, or
# "MNFT-ABCD/1" to send NFT nonce #1 of the MNFT-ABCD collection.
# Required.
KLV_KDA_ID=

# Network to broadcast on.
KLV_NETWORK=testnet

# Token amount in smallest units. KDA tokens have variable precision — make sure
# this matches the asset you are sending. For NFTs, use 1.
KLV_AMOUNT=1
