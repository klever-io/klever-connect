# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# Path to the compiled WASM. Defaults to the counter fixture path.
WASM_PATH=../_fixtures/counter/output/counter.wasm

# Path to the ABI JSON. Defaults to the counter fixture path.
ABI_PATH=../_fixtures/counter/output/counter.abi.json

# Constructor arguments (comma-separated strings) — leave blank for the counter.
CONSTRUCTOR_ARGS=

# Deploy metadata flags. Each is "true" or "false". Defaults shown.
META_UPGRADEABLE=true
META_READABLE=true
META_PAYABLE=false
META_PAYABLE_BY_SC=false

KLV_NETWORK=testnet
