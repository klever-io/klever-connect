# Sender's hex Ed25519 private key. Must own the NFT and have KLV for fees.
KLV_PRIVATE_KEY=

# Recipient bech32 address.
KLV_RECIPIENT=

# NFT identifier in the form COLLECTION-XXXX/<nonce>, e.g. MNFT-ABCD/1
KLV_NFT_ID=

# Network. Default testnet.
KLV_NETWORK=testnet

# Royalties to pay alongside the transfer (smallest units).
# Either or both may be set; both default to 0 (no royalties).
# - KLV_ROYALTIES_KLV pays in native KLV (6 decimals smallest units)
# - KLV_ROYALTIES_KDA pays in the SAME KDA being transferred
KLV_ROYALTIES_KLV=0
KLV_ROYALTIES_KDA=0
