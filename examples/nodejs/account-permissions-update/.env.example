# Hex Ed25519 private key of the account whose permissions are being updated. REQUIRED.
PRIVATE_KEY=

# JSON describing the new permissions array. REQUIRED.
# Each permission has: type (0=Owner, 1=User), permissionName, threshold, operations (hex string), signers[].
# Each signer has: address (klv1...), weight (raw integer string or number).
#
# Minimal example: a single owner permission with two co-signers, threshold 2.
PERMISSIONS_JSON=[
  {
    "type": 0,
    "permissionName": "owner",
    "threshold": 2,
    "operations": "0x000000",
    "signers": [
      {"address": "klv1ALICEALICEALICEALICEALICEALICEALICEALICEALICEALICEALICEALICEALICEALICE", "weight": 1},
      {"address": "klv1BOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBBOBB", "weight": 1}
    ]
  }
]

KLV_NETWORK=testnet

# This example STOPS at "request built". A real multi-sig update needs each
# signer to sign offline and aggregate signatures — out of scope for a single-
# binary example. Set BROADCAST_SINGLE_SIGNED=true to broadcast the
# single-signed transaction anyway (useful for accounts not yet under multi-sig).
BROADCAST_SINGLE_SIGNED=false
