# Hex Ed25519 private key of the marketplace owner. REQUIRED.
PRIVATE_KEY=

# UTF-8 marketplace display name. REQUIRED.
MARKETPLACE_NAME=My Klever Marketplace

# Optional referral payout address (referral fees go here when a buyer arrives via a referrer).
REFERRAL_ADDRESS=

# Optional referral percentage in basis points × 100 (0–10000). Default 0 = no referrals.
REFERRAL_PERCENTAGE=0

KLV_NETWORK=testnet
DRY_RUN=true
