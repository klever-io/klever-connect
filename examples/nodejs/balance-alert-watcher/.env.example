# Comma-separated list of klv1 addresses to watch. REQUIRED.
ADDRESSES=

# Asset id to watch (default KLV).
ASSET_ID=KLV

# Polling interval in ms. Default 8000.
POLL_INTERVAL_MS=8000

# Optional minimum delta (raw smallest units) before an alert fires.
# Default 1 (any change triggers).
MIN_DELTA=1

# Number of polls before exiting (useful in CI). Set to 0 to run forever.
MAX_POLLS=10

KLV_NETWORK=testnet
