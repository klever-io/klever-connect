# Transaction hash to wait for (64-hex). REQUIRED.
TX_HASH=

# How long to wait, in milliseconds, before giving up. Default 60000.
TIMEOUT_MS=60000

# How often to poll the provider while we don't yet have a result. Default 2000.
POLL_INTERVAL_MS=2000

# Network. Defaults to testnet.
KLV_NETWORK=testnet
