# Hex Ed25519 private key of the proposer. REQUIRED.
PRIVATE_KEY=

# JSON object describing the parameters being proposed for change.
# Keys are integer parameter IDs (as strings — JSON keys are always strings),
# values are the new value as a string. Example targets a single param:
#   PROPOSAL_PARAMETERS='{"22":"5000"}'
# Multiple params:
#   PROPOSAL_PARAMETERS='{"22":"5000","23":"100"}'
# REQUIRED.
PROPOSAL_PARAMETERS={"22":"5000"}

# Free-form description shown to voters. Optional.
PROPOSAL_DESCRIPTION=Lower minimum-stake parameter to 5000 KLV

# How many epochs the proposal stays open for voting. Optional.
PROPOSAL_EPOCHS_DURATION=10

KLV_NETWORK=testnet
DRY_RUN=true
