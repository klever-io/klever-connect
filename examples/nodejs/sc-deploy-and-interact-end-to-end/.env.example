# Hex Ed25519 private key with enough KLV to deploy + a few invocations. REQUIRED.
PRIVATE_KEY=

# Counter fixture artifacts (built via `cd examples/_fixtures/counter && sc-meta all build`).
WASM_PATH=../_fixtures/counter/output/counter.wasm
ABI_PATH=../_fixtures/counter/output/counter.abi.json

# How many times to call increment() after deploy. Default 3.
INCREMENT_TIMES=3

KLV_NETWORK=testnet
