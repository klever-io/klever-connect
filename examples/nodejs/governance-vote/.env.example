# Hex Ed25519 private key of the voter. REQUIRED.
PRIVATE_KEY=

# Numeric proposal id (look it up on the explorer or from the
# governance-create-proposal receipt). REQUIRED.
PROPOSAL_ID=0

# Vote choice: "yes" or "no". REQUIRED.
VOTE=yes

# Stake-weighted vote amount in raw KLV smallest units. Optional —
# leave blank to vote with full effective stake (chain default).
VOTE_AMOUNT=

KLV_NETWORK=testnet
DRY_RUN=true
