# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# Deployed payable contract address. REQUIRED.
CONTRACT_ADDRESS=

# Path to the contract's ABI. Defaults to the counter fixture path; replace
# with your own payable contract's ABI in production.
ABI_PATH=../_fixtures/counter/output/counter.abi.json

# Function name to invoke. Default "topUp" — change to a payable endpoint of
# whatever contract you target.
FUNCTION_NAME=topUp

# Comma-separated args (strings).
FUNCTION_ARGS=

# Human-readable amount of KLV to send alongside the call (parseKLV applied).
KLV_AMOUNT=10

KLV_NETWORK=testnet
DRY_RUN=true
