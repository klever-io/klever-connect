# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# Deposit type:
#   0 = FPR pool   — fund the validator's FPR (Flat Reward) pool
#   1 = KDA pool   — top up a KDA's reward pool
# REQUIRED.
DEPOSIT_TYPE=0

# Asset id whose pool you are funding. Required for KDA pools (DEPOSIT_TYPE=1).
# Optional / unused for FPR (DEPOSIT_TYPE=0).
KDA_ID=

# Currency you are depositing (e.g. KLV, KFI). Optional — chain default usually applies.
CURRENCY_ID=KLV

# Amount in raw smallest units (use parseKLV for KLV — see README). REQUIRED.
AMOUNT=10000000

KLV_NETWORK=testnet
DRY_RUN=true
