# Hex-encoded Ed25519 private key (64 hex chars, NO 0x prefix). REQUIRED.
# This is the operator account that will own the validator. It must hold enough
# KLV on the chosen network to cover the Validator-Create fee + the
# self-stake bond required for the role.
PRIVATE_KEY=

# BLS public key of the validator node, hex-encoded (96 bytes / 192 hex chars on Klever).
# This MUST be the BLS key generated by the node binary (`klever-go validator-key …`)
# and registered in the genesis or via the chain's onboarding process. The example
# can BUILD the transaction with any BLS-shaped string, but the chain will reject
# it on broadcast unless it is a real, eligible BLS key.
BLS_PUBLIC_KEY=

# Reward payout address. Defaults to the operator address if blank.
REWARD_ADDRESS=

# Whether the validator accepts external delegations (true/false). Default true.
CAN_DELEGATE=true

# Commission percentage in basis points × 100 (e.g. 500 = 5.00%). Range: 0–10000.
COMMISSION=500

# Maximum delegation cap in raw KLV units (use parseKLV in the example to convert
# from human-readable). Optional. Leave blank for "no cap".
MAX_DELEGATION_AMOUNT=

# Display name for the validator (UTF-8). Optional.
VALIDATOR_NAME=

# Network to broadcast on. One of: mainnet | testnet | devnet | local
KLV_NETWORK=testnet

# When DRY_RUN=true, the example builds + signs the transaction but does NOT broadcast it.
# Useful for inspecting the wire format without spending fees.
DRY_RUN=true
