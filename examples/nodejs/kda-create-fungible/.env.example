# Hex Ed25519 key of the OWNER. The wallet pays the CreateAsset fee (large — check
# https://docs.klever.org/ for current values, on the order of thousands of KLV on mainnet).
KLV_PRIVATE_KEY=

# Asset name — alphanumeric only, no spaces or punctuation.
KLV_KDA_NAME=MyTestToken

# Ticker — alphanumeric, typically 3-5 uppercase letters.
KLV_KDA_TICKER=MTT

# Decimal precision (6 mirrors KLV; choose what makes sense for your asset).
KLV_KDA_PRECISION=6

# Initial supply minted to the owner, in smallest units.
# 1_000_000 with precision 6 = 1 token. Default 1_000_000_000 = 1000 tokens.
KLV_KDA_INITIAL_SUPPLY=1000000000

# Maximum supply hard cap, in smallest units. 0 means unlimited (only if canMint=true).
KLV_KDA_MAX_SUPPLY=10000000000

# Network — keep testnet to avoid burning real KLV on the asset-creation fee.
KLV_NETWORK=testnet
