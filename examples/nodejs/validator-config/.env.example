# Validator owner's Ed25519 hex private key (no 0x). REQUIRED.
PRIVATE_KEY=

# BLS public key of the validator being updated. REQUIRED — the chain uses this
# to identify which validator entry to mutate.
BLS_PUBLIC_KEY=

# New reward address. Optional — leave blank to keep existing.
REWARD_ADDRESS=

# Whether the validator should accept external delegations. Optional.
# Set to "true" or "false" to update; leave blank to keep existing.
CAN_DELEGATE=

# Commission in basis points × 100 (0–10000). Optional. Leave blank to keep existing.
COMMISSION=

# Max delegation cap in human-readable KLV (parseKLV will convert). Optional.
MAX_DELEGATION_AMOUNT=

# New validator display name. Optional.
VALIDATOR_NAME=

KLV_NETWORK=testnet
DRY_RUN=true
