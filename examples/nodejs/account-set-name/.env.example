# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# UTF-8 alias to assign to the account. REQUIRED.
ACCOUNT_NAME=alice.klever

KLV_NETWORK=testnet
DRY_RUN=true

# When true, after a non-dry-run broadcast, poll the account until the new name
# shows up via provider.getAccount(...). Defaults to true when DRY_RUN=false.
VERIFY_AFTER_BROADCAST=true
