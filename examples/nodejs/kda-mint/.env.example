# Hex Ed25519 key. Wallet must have the mint role on KLV_KDA_ID, OR be the owner.
KLV_PRIVATE_KEY=

# Asset id. For fungible mints, the bare id (e.g. MTT-ABCD).
# For NFT minting, the COLLECTION id (e.g. MNFT-ABCD) — the chain assigns the
# next nonce.
KLV_KDA_ID=

# Mint mode: "fungible" or "nft". Default fungible.
KLV_MINT_MODE=fungible

# (fungible) Amount to mint in smallest units. Default: 1_000_000.
KLV_MINT_AMOUNT=1000000

# (fungible) Recipient. Default: sender.
KLV_MINT_RECEIVER=

# (nft) Optional metadata URIs as JSON, e.g. {"image":"ipfs://...","metadata":"ipfs://..."}
KLV_MINT_NFT_URIS=

# (nft) Optional MIME type, e.g. "image/png".
KLV_MINT_NFT_MIME=

# Network. Default testnet.
KLV_NETWORK=testnet
