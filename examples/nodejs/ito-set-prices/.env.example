# Hex Ed25519 private key of the ITO owner. REQUIRED.
PRIVATE_KEY=

# KDA asset id whose ITO prices are being updated. REQUIRED.
KDA_ID=

# JSON of currencyId -> PackInfo. REQUIRED. Example:
# PACK_INFO_JSON='{"KLV":{"packs":[{"amount":"1","price":"1000000"}]}}'
PACK_INFO_JSON={"KLV":{"packs":[{"amount":"1","price":"1500000"}]}}

KLV_NETWORK=testnet
DRY_RUN=true
