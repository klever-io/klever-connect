# Asset OWNER's hex Ed25519 key.
KLV_PRIVATE_KEY=

# Asset id (typically an NFT collection).
KLV_KDA_ID=

# Address that receives royalty payments.
KLV_ROYALTIES_ADDRESS=

# Royalty percentage on transfer in basis points (10000 = 100.00%).
# E.g. 500 = 5.00% — must be within asset-defined max.
KLV_ROYALTIES_TRANSFER_PERCENTAGE=500

# Royalty fixed amount on transfer (smallest units of asset OR KLV depending on
# config). 0 disables.
KLV_ROYALTIES_TRANSFER_FIXED=0

# Royalty percentage on market sales (basis points). 500 = 5.00%.
KLV_ROYALTIES_MARKET_PERCENTAGE=500

# Royalty fixed amount on market sales (smallest units of KLV).
KLV_ROYALTIES_MARKET_FIXED=0

# Network. Default testnet.
KLV_NETWORK=testnet
