# Hex Ed25519 private key of the seller. REQUIRED.
PRIVATE_KEY=

# Marketplace id (64-hex string from the flow-39 receipt). REQUIRED.
MARKETPLACE_ID=

# Asset id being listed (e.g. "KFI", or an NFT like "MYNFT-AB12/03"). REQUIRED.
ASSET_ID=

# Marketplace listing type:
#   0 = BuyItNow (price is final)
#   1 = Auction  (price is starting bid; reservePrice + endTime apply)
MARKET_TYPE=0

# Optional currency the price is quoted in. Defaults to KLV when omitted.
CURRENCY_ID=KLV

# Sale price in raw smallest units (integer). REQUIRED.
PRICE=1000000

# Reserve price for auctions. Optional and ignored when MARKET_TYPE=0.
RESERVE_PRICE=

# Auction end timestamp in seconds since the epoch. Required when MARKET_TYPE=1.
END_TIME=

KLV_NETWORK=testnet
DRY_RUN=true
