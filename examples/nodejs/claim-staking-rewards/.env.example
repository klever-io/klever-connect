# Sender's hex Ed25519 key. Wallet must have a frozen+delegated bucket producing rewards.
KLV_PRIVATE_KEY=

# Claim type:
#   0 = APR (StakingClaim)         — default; the standard validator-staking yield
#   1 = AllowanceClaim
#   3 = FPR (KDA Pool)             — kda freeze rewards
# Default 0.
KLV_CLAIM_TYPE=0

# Optional KDA id required when KLV_CLAIM_TYPE=3 (FPR). Leave blank for type 0.
KLV_CLAIM_KDA=

# Network. Default testnet.
KLV_NETWORK=testnet
