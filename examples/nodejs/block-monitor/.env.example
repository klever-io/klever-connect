# Network. Defaults to testnet.
KLV_NETWORK=testnet

# Polling interval in ms. Default 4000.
POLL_INTERVAL_MS=4000

# How many ms can elapse between blocks before we emit a "slow-block" warning. Default 30000.
SLOW_BLOCK_THRESHOLD_MS=30000

# How many blocks to observe before exiting (useful for demos / CI). Set to 0 for "run forever".
MAX_BLOCKS=5
