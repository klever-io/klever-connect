# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# JSON array of recipients. Each entry: { receiver, amount }, where amount is
# in raw smallest units (or human-readable when AMOUNT_UNIT=human, see below).
# Example:
# RECIPIENTS_JSON=[{"receiver":"klv1...","amount":"100000"},{"receiver":"klv1...","amount":"200000"}]
RECIPIENTS_JSON=

# Either "raw" (default) or "human". When "human", each recipient.amount is
# treated as a KLV amount and converted via parseKLV.
AMOUNT_UNIT=raw

KLV_NETWORK=testnet
DRY_RUN=true
