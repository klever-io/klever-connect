# Hex Ed25519 owner key. Pays the CreateAsset fee.
KLV_PRIVATE_KEY=

# Collection name (alphanumeric only).
KLV_NFT_NAME=MyNFTCollection

# Collection ticker (alphanumeric).
KLV_NFT_TICKER=MNFT

# Maximum number of NFTs that can be minted in this collection.
# Default: 10000. Use 0 for unlimited (only with canMint=true).
KLV_NFT_MAX_SUPPLY=10000

# Optional logo URL.
KLV_NFT_LOGO=https://example.com/collection-logo.png

# Network — default testnet.
KLV_NETWORK=testnet
