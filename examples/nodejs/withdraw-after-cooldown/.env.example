# Sender's hex Ed25519 key. Wallet that owns the unfrozen-and-cooled-down bucket.
KLV_PRIVATE_KEY=

# Network. Default testnet.
KLV_NETWORK=testnet

# Withdraw type:
#   0 = Staking unfreeze withdrawal (default; use after running flow 21 unfreeze)
#   1 = KDA Pool withdrawal (FPR)
KLV_WITHDRAW_TYPE=0

# Asset to withdraw. Default KLV.
KLV_KDA=KLV
