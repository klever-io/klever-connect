# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# Path to the recipients CSV. REQUIRED. Sample format (with header row):
#   receiver,amount,kda
#   klv1...,1,KLV
#   klv1...,5,MYTKN-AB12
# Header row MUST exist. The "kda" column is optional — leave blank for KLV.
CSV_PATH=./recipients.csv

# Either "raw" (amounts already in smallest units) or "human" (default; amounts
# are human-readable for KLV — KDA amounts are still treated as raw).
AMOUNT_UNIT=human

# Maximum batch size per broadcastTransactions() call. The remainder is
# split across multiple batches.
BATCH_SIZE=50

KLV_NETWORK=testnet
DRY_RUN=true
