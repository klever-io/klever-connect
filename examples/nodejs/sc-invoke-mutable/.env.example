# Hex Ed25519 private key. REQUIRED.
PRIVATE_KEY=

# Deployed counter contract address (klv1qqq…). REQUIRED.
# Get this by running flow 60 (sc-deploy) first, or by reading
# ContractFactory.getDeployedAddress(receipt) from a previous deploy.
CONTRACT_ADDRESS=

# Path to the counter ABI JSON. Defaults to the bundled fixture path.
# After running the Rust toolchain on examples/_fixtures/counter, the build
# output appears at examples/_fixtures/counter/output/counter.abi.json.
ABI_PATH=../_fixtures/counter/output/counter.abi.json

# Function name to invoke (default: "increment" for the counter fixture).
FUNCTION_NAME=increment

# Optional comma-separated args (parsed as strings). The counter's increment
# takes no args; for a contract whose function takes (u32, address) you'd set:
#   FUNCTION_ARGS=42,klv1...
FUNCTION_ARGS=

KLV_NETWORK=testnet
DRY_RUN=true
