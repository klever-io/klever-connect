# Vite-exposed environment variables (anything starting with `VITE_` is bundled
# into the client). This example does NOT need any signing — it only exercises
# pure validation helpers (`isValidAddress`, `parseKLV`) — but we still pin the
# network so you can use the same .env style across the example library.

VITE_NETWORK=testnet

# DO NOT add VITE_DEV_PRIVATE_KEY here. The settled rule for the example
# library is "never hardcode private keys, even in .env.example". This example
# never signs anything; the production runtime uses the Klever Web Extension.
