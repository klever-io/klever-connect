# Vite environment variables - copy to .env.local and tweak.
# Vars exposed to the browser MUST be prefixed VITE_.

# Network: mainnet | testnet | devnet | local. Default testnet.
VITE_KLV_NETWORK=testnet
# Default bucket id and validator address (optional pre-fill).
VITE_KLV_BUCKET_ID=
VITE_KLV_VALIDATOR=
