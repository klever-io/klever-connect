{
  "name": "@klever/example-reactjs-react-provider-setup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Minimal Vite + React 19 app showing how to wrap your tree in <KleverProvider>.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude \"**/*.testnet.*\"",
    "test:testnet": "vitest run -- --testNamePattern testnet"
  },
  "dependencies": {
    "@klever/connect": "workspace:*",
    "@klever/connect-react": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
